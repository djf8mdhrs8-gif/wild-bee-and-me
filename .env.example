#===============================================================================
# The Wild Bee & Me — environment variables
#
# Copy this file to `.env.local` for local development:
#     cp .env.example .env.local        (macOS/Linux)
#     Copy-Item .env.example .env.local (Windows PowerShell)
#
# In production, add the same keys in Vercel:
#     Project → Settings → Environment Variables
#
# EVERY VARIABLE BELOW IS OPTIONAL. With none of them set, the site builds,
# deploys and works — form submissions are logged to the server console instead
# of being delivered anywhere.
#===============================================================================


#-------------------------------------------------------------------------------
# 1. SITE URL  (recommended before launch)
#-------------------------------------------------------------------------------
# The canonical origin. Used for canonical tags, Open Graph URLs, sitemap.xml,
# robots.txt and the LocalBusiness/Product structured data.
#
# No trailing slash. Set this to the real domain once it's attached, otherwise
# search engines will see the placeholder below in your metadata.
NEXT_PUBLIC_SITE_URL=https://www.thewildbeeandme.com


#-------------------------------------------------------------------------------
# 2. EMAIL NOTIFICATIONS via Resend  (recommended)
#-------------------------------------------------------------------------------
# Where bee-removal requests, contact messages, newsletter signups and orders
# get emailed. Sign up free at https://resend.com, verify your sending domain,
# then create an API key.
#
# Leave blank to skip email entirely.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Who receives the notifications. Comma-separate for multiple recipients.
NOTIFY_TO_EMAIL=

# Who they appear to come from. MUST be on a domain verified in Resend.
NOTIFY_FROM_EMAIL=


#-------------------------------------------------------------------------------
# 3. WEBHOOK NOTIFICATIONS  (optional — works alongside or instead of email)
#-------------------------------------------------------------------------------
# Any URL that accepts a JSON POST. Useful for pushing submissions into Zapier,
# Make, n8n, a Slack Workflow Builder webhook, or a Google Sheet.
#
# The payload is: { kind, subject, text, fields, receivedAt }
# `kind` is one of: bee-removal-request | contact-message | newsletter-signup | order
NOTIFY_WEBHOOK_URL=


#-------------------------------------------------------------------------------
# 4. STRIPE  (PLACEHOLDER — not wired up yet)
#-------------------------------------------------------------------------------
# The shop currently runs a MANUAL ORDER FLOW: a customer places an order, the
# farm gets notified, and Ashley emails a payment link. No card details are ever
# entered on this site, and no payment processor is connected.
#
# Note there is also no shipping: orders are collected in Alva or delivered
# locally, so the order total is simply the goods.
#
# These two slots exist so real Stripe Checkout can be switched on later without
# restructuring anything. Setting them alone does NOT enable payments — see the
# step-by-step guide in README.md → "Connecting Stripe later", and the detailed
# code comment at the top of src/app/api/checkout/route.ts.

# Server-side secret key (sk_test_... / sk_live_...). NEVER commit a real value.
STRIPE_SECRET_KEY=

# Client-side publishable key (pk_test_... / pk_live_...). Safe to expose.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Signing secret for the /api/stripe/webhook route you'll add (whsec_...).
STRIPE_WEBHOOK_SECRET=
