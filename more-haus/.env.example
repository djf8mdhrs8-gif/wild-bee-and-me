# MORE HAUS — environment
#
# Copy to .env.local for development, and set the same variables on the host
# for production. Until these are set, inquiries and newsletter signups are
# written to the server log and reach nobody.

# Every contact-form submission is POSTed here as JSON.
# Point at a form service, email relay, automation hook or CRM.
INQUIRY_WEBHOOK_URL=

# Every newsletter signup is POSTed here as JSON.
# Point at the mailing list provider.
NEWSLETTER_WEBHOOK_URL=
